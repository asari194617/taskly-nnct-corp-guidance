{
  "$schema": "./apps/web/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{js,mjs,cjs,jsx,ts,tsx,json,jsonc,css,yml,yaml,md}",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/dist",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.e2e",
      "!**/data",
      "!**/private",
      "!**/package-lock.json",
      "!apps/web/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": { "enabled": false }
}
