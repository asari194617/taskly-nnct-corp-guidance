ADDR=127.0.0.1:3071
MYSQL_DSN='guidance:development-only@tcp(127.0.0.1:3308)/guidance?parseTime=true&charset=utf8mb4&loc=UTC'
# Private extraction input for administrator import tools; not read by the API.
DATA_DIR=/absolute/path/to/private-guidance-documents
# Private document storage. Never use the public UI bucket for source documents.
DOCUMENT_STORAGE=r2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-private-guidance-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UI_ORIGIN=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:3071
AUTH_ISSUER=http://localhost:3067
AUTH_CLIENT_ID=nnct-corp-guidance-2026
# Optional Taskly integration: configure both together, or leave both empty.
# Local Taskly API example: http://localhost:3063; event ID must match Taskly.
TASKLY_API_ORIGIN=
TASKLY_GUIDANCE_EVENT_ID=
# Generate: openssl rand -base64 32. Never commit the generated key.
SESSION_ENCRYPTION_KEY=
